# Copy to .env (or set these in your host's build settings), then rebuild.

# Where the contact form POSTs. Any Formspree-compatible endpoint works: it must accept
# multipart form data, answer JSON when sent `Accept: application/json`, and return
# {"errors":[{"message":"..."}]} on failure. Create a form at https://formspree.io and paste its URL.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id

# Optional. When set, the Contact page shows "Or write to <email>" and form errors offer it as a fallback.
VITE_CONTACT_EMAIL=
